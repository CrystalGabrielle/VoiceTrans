config.json

# ---------- 第三方驱动包（体积大，且非本项目代码）----------
tools/*.zip
tools/VBCABLE/

# ---------- 编辑器与系统文件 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
