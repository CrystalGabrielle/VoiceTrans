# ---------- Python ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- 运行时产物 ----------
# 录音文件（本机试音，不进仓库），但保留目录
recordings/*
